						<div><dt class="text-muted">Programming</dt><dd class="mt-1 leading-6">Python · JavaScript/TypeScript · SQL · C++ · PHP</dd></div>
						<div><dt class="text-muted">Engineering</dt><dd class="mt-1 leading-6">React · Next.js · Redux Toolkit · Node.js · Express.js · REST APIs</dd></div>
						<div><dt class="text-muted">Data</dt><dd class="mt-1 leading-6">MySQL · MongoDB · Firestore · Data Analysis · Power BI</dd></div>
						<div><dt class="text-muted">AI</dt><dd class="mt-1 leading-6">Machine Learning · NLP · Embeddings · RAG · Vector Databases</dd></div>
						<div><dt class="text-muted">Infrastructure</dt><dd class="mt-1 leading-6">Firebase · Docker · Vercel · Git · GitHub · Linux · DigitalOcean</dd></div>
					</dl>
				</section>
				<section class="mt-8" aria-labelledby="languages-title">
					<h2 id="languages-title" class="font-mono text-xs uppercase tracking-[0.18em] text-muted">Languages</h2>
