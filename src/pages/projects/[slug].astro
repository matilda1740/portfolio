---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectActions from '../../components/ProjectActions.astro';
import ProjectBreadcrumbs from '../../components/ProjectBreadcrumbs.astro';
import ProjectPager from '../../components/ProjectPager.astro';
import ProjectSectionIndex from '../../components/ProjectSectionIndex.astro';

export async function getStaticPaths() {
	const projects = (await getCollection('projects', ({ data }) => data.published))
		.sort((a, b) => (a.data.sortOrder ?? Number.MAX_SAFE_INTEGER) - (b.data.sortOrder ?? Number.MAX_SAFE_INTEGER));

	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content, headings } = await render(project);
const sectionHeadings = headings.filter(({ depth }) => depth === 2);
const projects = (await getCollection('projects', ({ data }) => data.published))
	.sort((a, b) => (a.data.sortOrder ?? Number.MAX_SAFE_INTEGER) - (b.data.sortOrder ?? Number.MAX_SAFE_INTEGER));
const projectIndex = projects.findIndex((entry) => entry.id === project.id);
const previousProject = projects[projectIndex - 1];
const nextProject = projects[projectIndex + 1];
const projectActions = [
	project.data.githubUrl && { label: 'View on GitHub ↗', href: project.data.githubUrl, emphasis: 'primary' as const },
	project.data.demoUrl && { label: 'Try live demo ↗', href: project.data.demoUrl },
	project.data.figmaUrl && { label: 'View Figma prototype ↗', href: project.data.figmaUrl, emphasis: 'primary' as const },
	project.data.paperUrl && { label: 'Read paper ↗', href: project.data.paperUrl },
	project.data.externalUrl && { label: 'View project ↗', href: project.data.externalUrl },
].filter((action): action is { label: string; href: string; emphasis?: 'primary' | 'secondary' } => Boolean(action));
const siteUrl = Astro.site ?? new URL('https://www.matildagitonga.com');
const projectUrl = new URL(`/projects/${project.id}/`, siteUrl).toString();
const projectImageUrl = new URL(project.data.thumbnail ?? '/images/matilda-portrait.png', siteUrl).toString();
const projectStructuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'CreativeWork',
		name: project.data.title,
		description: project.data.summary,
		url: projectUrl,
		image: projectImageUrl,
		creator: {
			'@type': 'Person',
			name: 'Matilda Mwendwa Gitonga',
			url: 'https://www.matildagitonga.com/',
		},
		keywords: project.data.tags.join(', '),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{
				'@type': 'ListItem',
				position: 1,
				name: 'Home',
				item: 'https://www.matildagitonga.com/',
			},
			{
				'@type': 'ListItem',
				position: 2,
				name: 'Selected work',
				item: 'https://www.matildagitonga.com/#work',
			},
			{
				'@type': 'ListItem',
				position: 3,
				name: project.data.title,
				item: projectUrl,
			},
		],
	},
];
---

<BaseLayout
	title={`Matilda Gitonga — ${project.data.title}`}
	description={project.data.summary}
	image={project.data.thumbnail ?? '/images/matilda-portrait.png'}
	type="article"
	structuredData={projectStructuredData}
>
	<main class="mx-auto max-w-7xl px-6 pt-6 pb-10 sm:px-12 sm:pt-8 sm:pb-12">
		<div class="project-orientation border-b border-border pb-4">
			<ProjectBreadcrumbs title={project.data.title} />
			<ProjectPager previous={previousProject && { id: previousProject.id, title: previousProject.data.title }} next={nextProject && { id: nextProject.id, title: nextProject.data.title }} />
		</div>

		<div class="project-page-layout mt-5">
			<div>
				<header class="project-intro pb-6">
					<div class="project-intro-heading">
						<div class="project-intro-title-group">
							<h1 class="font-heading text-2xl leading-tight sm:text-4xl">{project.data.title}</h1>
							<p class="project-intro-meta">
								<span>{project.data.category}</span>
								<span aria-hidden="true">·</span>
								<span>{project.data.year}</span>
							</p>
						</div>
						<div class="project-intro-actions">
							<ProjectActions actions={projectActions} />
						</div>
					</div>
					<p class="project-intro-summary mt-4 text-lg leading-8 text-muted">{project.data.summary}</p>
					{(project.data.role || project.data.organization) && <dl class="project-intro-context mt-4 flex flex-wrap gap-x-6 gap-y-2 text-sm">
						{project.data.role && <div>
							<dt>Role</dt>
							<dd>{project.data.role}</dd>
						</div>}
						{project.data.organization && <div>
							<dt>Organization</dt>
							<dd>{project.data.organization}</dd>
						</div>}
					</dl>}
					<div class="project-intro-media mt-4">
						{project.data.thumbnail && <figure class="project-intro-image">
							<img src={project.data.thumbnail} alt={project.data.thumbnailAlt ?? `${project.data.title} preview`} class="h-auto w-full" loading="eager" decoding="async" />
						</figure>}
						<aside class="project-intro-outcome rounded-xl border-l-2 border-accent px-3 py-2 text-sm leading-6 text-foreground">
							<p class="project-intro-outcome-label">Outcome</p>
							<p>{project.data.outcome}</p>
						</aside>
					</div>
				</header>

				<div class="project-reading-layout">
					<ProjectSectionIndex headings={sectionHeadings} />
					<article class="project-technical-content prose prose-base mt-6 max-w-none prose-headings:font-heading prose-headings:font-normal prose-headings:text-foreground prose-p:text-foreground prose-a:text-accent prose-a:decoration-accent prose-strong:text-foreground prose-blockquote:border-accent prose-blockquote:text-muted prose-code:text-accent prose-li:text-foreground prose-img:my-6 prose-img:w-full prose-img:rounded-2xl prose-img:border prose-img:border-border prose-img:bg-surface">
						<Content />
					</article>
				</div>
			</div>
		</div>

	</main>
</BaseLayout>
