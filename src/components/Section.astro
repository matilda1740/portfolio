---
interface Props {
	id?: string;
	borderTop?: boolean;
	class?: string;
	innerClass?: string;
}

const {
	id,
	borderTop = false,
	class: className = '',
	innerClass = '',
} = Astro.props;
---

<section id={id} class:list={[borderTop && 'border-t border-border', className]}>
	<div class:list={['mx-auto max-w-7xl px-6 sm:px-10', innerClass]}>
		<slot />
	</div>
</section>
