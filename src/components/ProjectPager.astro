---
interface ProjectLink {
	id: string;
	title: string;
}

interface Props {
	previous?: ProjectLink;
	next?: ProjectLink;
}

const { previous, next } = Astro.props;
const hasPrevious = Boolean(previous);
const hasNext = Boolean(next);
const hasBoth = hasPrevious && hasNext;
---

<nav aria-label="Adjacent projects" class:list={[
	'mt-4 flex items-center gap-x-6 gap-y-2 text-xs',
	hasBoth ? 'justify-between' : hasPrevious ? 'justify-start' : 'justify-end',
]}>
	{previous ? <a class="group min-w-0 text-muted hover:text-foreground" href={`/projects/${previous.id}`}>
		<span class="uppercase tracking-[0.12em]">← Previous: </span>
		<span class="font-medium text-foreground group-hover:text-accent">{previous.title}</span>
	</a> : null}
	{next ? <a class="group min-w-0 text-muted hover:text-foreground" href={`/projects/${next.id}`}>
		<span class="uppercase tracking-[0.12em]">Next: </span>
		<span class="font-medium text-foreground group-hover:text-accent">{next.title} →</span>
	</a> : null}
</nav>
