---
interface ProjectLink {
	id: string;
	title: string;
}

interface Props {
	previous?: ProjectLink;
	next?: ProjectLink;
	variant?: 'compact' | 'card';
}

const { previous, next, variant = 'compact' } = Astro.props;
const hasPrevious = Boolean(previous);
const hasNext = Boolean(next);
const hasBoth = hasPrevious && hasNext;
---

{variant === 'compact' ? (
	<nav aria-label="Adjacent projects" class:list={[
		'mt-4 flex items-center gap-x-6 gap-y-2 text-xs',
		hasBoth ? 'justify-between' : hasPrevious ? 'justify-start' : 'justify-end',
	]}>
		{previous ? <a class="group min-w-0 text-muted hover:text-foreground" href={`/projects/${previous.id}`}>
			<span class="uppercase tracking-[0.12em]">← Previous: </span>
			<span class="font-medium text-foreground group-hover:text-accent">{previous.title}</span>
		</a> : null}
		{next ? <a class="group min-w-0 text-muted hover:text-foreground" href={`/projects/${next.id}`}>
			<span class="uppercase tracking-[0.12em]">Next: </span>
			<span class="font-medium text-foreground group-hover:text-accent">{next.title}</span>
		</a> : null}
	</nav>
) : (
	<nav aria-label="Project navigation" class="mt-20 grid gap-4 border-t border-border pt-8 sm:grid-cols-2">
		{previous ? <a class:list={['interactive-surface rounded-2xl border border-border p-5', !hasBoth && 'sm:col-start-1']} href={`/projects/${previous.id}`}><span class="text-sm text-muted">← Previous project</span><span class="mt-2 block font-heading text-2xl">{previous.title}</span></a> : null}
		{next ? <a class:list={['interactive-surface rounded-2xl border border-border p-5 text-left sm:text-right', !hasBoth && 'sm:col-start-2']} href={`/projects/${next.id}`}><span class="text-sm text-muted">Next project →</span><span class="mt-2 block font-heading text-2xl">{next.title}</span></a> : null}
	</nav>
)}
