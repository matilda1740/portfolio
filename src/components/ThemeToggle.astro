<button
	type="button"
	class="inline-flex items-center gap-2 rounded-full border border-border px-3 py-2 text-sm text-foreground transition-colors hover:border-border-strong hover:bg-surface"
	data-theme-toggle
	aria-label="Use dark theme"
	aria-pressed="false"
>
	<span aria-hidden="true" data-theme-icon>☾</span>
	<span data-theme-label>Dark mode</span>
</button>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
	const icon = document.querySelector<HTMLElement>('[data-theme-icon]');
	const label = document.querySelector<HTMLElement>('[data-theme-label]');

	const updateToggle = () => {
		const isDark = document.documentElement.dataset.theme === 'dark';
		if (toggle && icon && label) {
			toggle.setAttribute('aria-pressed', String(isDark));
			toggle.setAttribute('aria-label', isDark ? 'Use light theme' : 'Use dark theme');
			icon.textContent = isDark ? '☀' : '☾';
			label.textContent = isDark ? 'Light mode' : 'Dark mode';
		}
	};

	toggle?.addEventListener('click', () => {
		const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = nextTheme;
		localStorage.setItem('theme', nextTheme);
		updateToggle();
	});

	updateToggle();
</script>
