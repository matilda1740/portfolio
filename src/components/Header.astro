---
import ThemeToggle from './ThemeToggle.astro';
---

<header class="border-b border-border">
	<div class="mx-auto max-w-7xl px-6 py-5 sm:px-10">
		<div class="flex items-center justify-between gap-6">
		<a href="/" class="inline-flex items-center gap-2 font-heading text-xl font-medium text-foreground">
			<img src="/images/icon-light.svg" data-theme-asset alt="" aria-hidden="true" class="h-7 w-7 object-contain" />
			<span>Matilda Gitonga</span>
		</a>
		<nav aria-label="Primary navigation" class="hidden items-center gap-6 text-sm sm:flex">
			<a class="text-muted transition-colors hover:text-foreground" href="/#work">Work</a>
			<a class="text-muted transition-colors hover:text-foreground" href="/#about">About</a>
			<a class="text-muted transition-colors hover:text-foreground" href="/resume">Resume</a>
			<a class="text-muted transition-colors hover:text-foreground" href="/#contact">Contact</a>
		</nav>
			<div class="flex items-center gap-3">
				<ThemeToggle />
				<button
					type="button"
					class="interactive-control inline-flex items-center rounded-full border border-border px-2.5 py-2 text-sm text-foreground sm:hidden"
					data-menu-toggle
					aria-expanded="false"
					aria-controls="mobile-navigation"
					aria-label="Open menu"
				>
					<svg class="menu-bars h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
						<path d="M4 7h16M4 12h16M4 17h16" />
					</svg>
					<svg class="menu-close hidden h-4 w-4" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
						<path d="m6 6 12 12M18 6 6 18" />
					</svg>
				</button>
			</div>
		</div>
		<nav id="mobile-navigation" aria-label="Mobile navigation" class="mt-4 hidden border-t border-border pt-4 sm:hidden">
			<div class="flex flex-col gap-4 text-sm">
				<a class="text-muted" href="/#work">Work</a>
				<a class="text-muted" href="/#about">About</a>
				<a class="text-muted" href="/resume">Resume</a>
				<a class="text-muted" href="/#contact">Contact</a>
			</div>
		</nav>
	</div>
</header>

<script>
	const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
	const mobileNavigation = document.querySelector<HTMLElement>('#mobile-navigation');

	menuToggle?.addEventListener('click', () => {
		const isOpen = menuToggle.getAttribute('aria-expanded') === 'true';
		menuToggle.setAttribute('aria-expanded', String(!isOpen));
		menuToggle.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
		mobileNavigation?.classList.toggle('hidden', isOpen);
		menuToggle.querySelector('.menu-bars')?.classList.toggle('hidden', !isOpen);
		menuToggle.querySelector('.menu-close')?.classList.toggle('hidden', isOpen);
	});

	mobileNavigation?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			menuToggle?.setAttribute('aria-expanded', 'false');
			menuToggle?.setAttribute('aria-label', 'Open menu');
			mobileNavigation.classList.add('hidden');
			menuToggle?.querySelector('.menu-bars')?.classList.remove('hidden');
			menuToggle?.querySelector('.menu-close')?.classList.add('hidden');
		});
	});
</script>
