---
interface Action {
	label: string;
	href: string;
	emphasis?: 'primary' | 'secondary';
}

interface Props {
	actions: Action[];
	class?: string;
}

const { actions, class: className = '' } = Astro.props;
---

<div class:list={['flex flex-wrap gap-3 text-sm', className]}>
	{actions.map((action) => (
		<a
			class:list={[
				'interactive-control rounded-full px-4 py-2 font-medium',
				action.emphasis === 'primary'
					? 'interactive-control--accent'
					: 'border border-border text-foreground',
			]}
			href={action.href}
			target="_blank"
			rel="noreferrer"
		>{action.label}</a>
	))}
</div>
