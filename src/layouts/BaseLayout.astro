---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	noindex?: boolean;
	structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title = 'Matilda Mwendwa Gitonga',
	description = 'The portfolio of Matilda Mwendwa Gitonga, a software engineer.',
	image = '/images/social-preview.png',
	type = 'website',
	noindex = false,
	structuredData,
} = Astro.props;
const siteUrl = Astro.site ?? new URL('https://www.matildagitonga.com');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl);
const socialImageUrl = new URL(image, siteUrl);
const structuredDataJson = structuredData ? JSON.stringify(structuredData).replace(/</g, '\\u003c') : undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="author" content="Matilda Mwendwa Gitonga" />
		<meta name="generator" content={Astro.generator} />
		<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
		<link rel="canonical" href={canonicalUrl} />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="og:site_name" content="Matilda Mwendwa Gitonga" />
		<meta property="og:locale" content="en_US" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImageUrl} />
		{structuredData && <script type="application/ld+json" set:html={structuredDataJson} />}
		<link rel="icon" data-theme-favicon href="/images/icon-light.svg?v=2" type="image/svg+xml" />
		<link rel="alternate icon" data-theme-fallback href="/images/icon-light.ico?v=2" type="image/x-icon" />
		<script is:inline>
			const savedTheme = localStorage.getItem('theme');
			const theme = savedTheme || 'light';
			document.documentElement.dataset.theme = theme;
			const updateThemeAssets = () => {
				const suffix = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
				document.querySelector('[data-theme-favicon]')?.setAttribute('href', `/images/icon-${suffix}.svg?v=2`);
				document.querySelector('[data-theme-fallback]')?.setAttribute('href', `/images/icon-${suffix}.ico?v=2`);
			};
			window.addEventListener('themechange', updateThemeAssets);
			window.addEventListener('DOMContentLoaded', updateThemeAssets);
			updateThemeAssets();
		</script>
		<title>{title}</title>
	</head>
	<body>
		<div id="top">
			<Header />
			<slot />
			<Footer />
		</div>
	</body>
</html>
